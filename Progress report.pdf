        <thead>
            <tr>
                <th>Metric</th>
                <th>Monolith (EC2)</th>
                <th>Container (EKS)</th>
                <th>Our Optimized Serverless</th>
                <th>Improvement Rate</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="bold-text">Avg Response Time</td>
                <td>342 ms</td>
                <td>198 ms</td>
                <td>87 ms</td>
                <td class="bold-text">3.9x Faster</td>
            </tr>
            <tr>
                <td class="bold-text">P99 Response Time</td>
                <td>1,240 ms</td>
                <td>620 ms</td>
                <td>310 ms</td>
                <td class="bold-text">4.0x Faster</td>
            </tr>
            <tr>
                <td class="bold-text">Throughput (RPS)</td>
                <td>480 RPS</td>
                <td>820 RPS</td>
                <td>2,100 RPS</td>
                <td class="bold-text">4.4x Higher</td>
            </tr>
            <tr>
                <td class="bold-text">Cold Start Delay</td>
                <td>N/A</td>
                <td>N/A</td>
                <td>150 ms</td>
                <td class="bold-text">Eliminated Gap</td>
            </tr>
            <tr>
                <td class="bold-text">Est. Monthly Cost</td>
                <td>$340</td>
